# Required for Composio tool execution from the Railway service
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_ENTITY_ID=default

# Optional: OpenAI / other providers if used as fallback
OPENAI_API_KEY=

# Security for the submit endpoint (recommended)
API_SECRET=change_me_to_a_long_random_string

# Logging
LOG_LEVEL=INFO
