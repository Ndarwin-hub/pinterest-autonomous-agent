COMPOSIO_API_KEY=
COMPOSIO_ENTITY_ID=default
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
OPENAI_API_KEY=
API_SECRET=
LOG_LEVEL=INFO

# Durable Railway volume
DATA_DIR=/data
JOB_DB_PATH=/data/pinterest_agent_jobs.db
PUBLISHED_DB_PATH=/data/published_products.db
DAILY_LEDGER_DB_PATH=/data/amazon_daily_ledger.db

# Amazon Creators API — blank credentials keep Amazon automation dormant
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=desiredplus-20
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_CREDENTIAL_VERSION=3.1
AMAZON_OAUTH_SCOPE=creatorsapi::default
AMAZON_SCHEDULER_ENABLED=true
AMAZON_SLOT_INTERVAL_SEC=5760
